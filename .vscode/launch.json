{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Flask (Port 5000)",
            "type": "python",
            "request": "launch",
            "module": "flask",
            "env": {
                "FLASK_APP": "app.py",
                "FLASK_DEBUG": "1"
            },
            "args": [
                "run",
                "--port",
                "5000"
            ],
            "jinja": true,
            "python": "${workspaceFolder}/venv/Scripts/python.exe"
        }
    ]
}
